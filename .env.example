# URL du webhook CRM (GHL ou autre) qui reçoit le JSON du lead
CRM_WEBHOOK_URL=

# Alerte par courriel si l'envoi au CRM échoue après 3 tentatives (via Resend : https://resend.com)
RESEND_API_KEY=
ALERT_EMAIL_FROM=alertes@gmvservices.ca
ALERT_EMAIL_TO=

# Meta Conversions API (serveur) — optionnel, en plus du Pixel déjà actif
# (l'ID du Pixel est versionné dans lib/brand.ts, pas besoin de le remettre ici
# sauf pour le surcharger avec NEXT_PUBLIC_META_PIXEL_ID)
META_CAPI_ACCESS_TOKEN=
